# LangSmith / Managed Deep Agents (private preview)
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_API_URL=https://api.smith.langchain.com

# Written by: make provision
MANAGED_AGENT_ID=

# Runtime: auto | managed | local | deployment
# auto = deployment URL if set, else managed if AGENT_ID+key, else local
AGENT_RUNTIME=auto

# LangSmith Deployment fallback (langgraph up / cloud deploy)
LANGGRAPH_DEPLOYMENT_URL=
LANGGRAPH_ASSISTANT_ID=

# Human-in-the-loop: require approval before web search (provision script reads this)
REQUIRE_HITL_APPROVAL=true

# Model for local/deployment graphs
DEFAULT_MODEL=anthropic:claude-sonnet-4-6

# Provider keys for local runtime (pick one matching DEFAULT_MODEL)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
